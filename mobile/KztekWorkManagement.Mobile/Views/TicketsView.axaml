<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KztekWorkManagement.Mobile.ViewModels"
             xmlns:conv="using:KztekWorkManagement.Mobile.Common"
             x:Class="KztekWorkManagement.Mobile.Views.TicketsView"
             x:DataType="vm:TicketsViewModel">

  <Grid RowDefinitions="Auto,*" Background="{DynamicResource KzBackground}">

    <!-- Top Search & Refresh -->
    <Grid Grid.Row="0" Margin="16,12,16,8" ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" Classes="kz-input" Text="{Binding SearchKeyword, Mode=TwoWay}" Watermark="🔍 Tra cứu mã ticket hoặc tên KH..." Margin="0,0,8,0" />
      <Button Grid.Column="1" Classes="kz-btn-primary" Command="{Binding RefreshCommand}" Padding="12,10">
        <TextBlock Text="Làm mới" FontSize="12" />
      </Button>
    </Grid>

    <!-- Tickets List (Virtualized ListBox) -->
    <Grid Grid.Row="1" Margin="0,0,0,80">
      <!-- Empty State -->
      <Border Classes="kz-card" Margin="16,4,16,8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Top"
              IsVisible="{Binding !Tickets.Count}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="🎫" FontSize="32" HorizontalAlignment="Center" />
          <TextBlock Text="Không có phiếu sự cố nào" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource KzTextSecondary}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Tickets Cards with Virtualized ListBox -->
      <ListBox ItemsSource="{Binding Tickets}"
               Background="Transparent"
               BorderThickness="0"
               Padding="16,4,16,16"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
              <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{TemplateBinding Padding}"/>
              </ControlTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="kz-card" Padding="14">
              <StackPanel Spacing="8">
                
                <!-- Tracking Code & Status -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TrackingCode}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource KzAccent}" />
                  
                  <Border Grid.Column="2" Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                  </Border>
                </Grid>

                <!-- Title -->
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

                <!-- Description -->
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource KzTextSecondary}" TextWrapping="Wrap" MaxLines="2" />

                <!-- Customer Info & Action -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding CustomerName, StringFormat='Khách hàng: {0}'}" FontSize="11" Foreground="{DynamicResource KzTextMuted}" />
                    <TextBlock Text="{Binding CustomerEmail}" FontSize="11" Foreground="{DynamicResource KzTextMuted}" />
                  </StackPanel>

                  <!-- Đóng / Hủy (bắt buộc lý do + mô tả) -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="kz-btn-outline"
                            Command="{Binding $parent[UserControl].((vm:TicketsViewModel)DataContext).CancelTicketCommand}"
                            CommandParameter="{Binding}" Padding="10,6" MinHeight="32"
                            IsVisible="{Binding CanCancel}">
                      <TextBlock Text="Hủy" FontSize="11" />
                    </Button>
                    <Button Classes="kz-btn-primary"
                            Command="{Binding $parent[UserControl].((vm:TicketsViewModel)DataContext).CloseTicketCommand}"
                            CommandParameter="{Binding}" Padding="10,6" MinHeight="32"
                            IsVisible="{Binding CanClose}">
                      <TextBlock Text="Đóng ✓" FontSize="11" />
                    </Button>
                  </StackPanel>
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Dialog Đóng / Hủy ticket (overlay trong view — app chưa có dịch vụ dialog dùng chung) -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsFinishDialogOpen}">
      <Border Classes="kz-card" Margin="16" Padding="16" VerticalAlignment="Center" MaxWidth="480">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FinishTitle}" FontSize="15" FontWeight="Bold" />
          <TextBlock Text="{Binding FinishError}" FontSize="12" Foreground="#C2410C" TextWrapping="Wrap"
                     IsVisible="{Binding FinishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="Lý do *" FontSize="12" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding FinishReasons}" SelectedItem="{Binding SelectedFinishReason, Mode=TwoWay}"
                    PlaceholderText="-- Chọn lý do --" HorizontalAlignment="Stretch" />
          <TextBlock Text="Mô tả gửi cho khách hàng *" FontSize="12" FontWeight="SemiBold" />
          <TextBox Classes="kz-input" Text="{Binding FinishDescription, Mode=TwoWay}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="90" Watermark="Mô tả kết quả xử lý / lý do..." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="kz-btn-outline" Command="{Binding DismissFinishCommand}" Padding="12,8">
              <TextBlock Text="Quay lại" FontSize="12" />
            </Button>
            <Button Classes="kz-btn-primary" Command="{Binding SubmitFinishCommand}" Padding="12,8">
              <TextBlock Text="Xác nhận &amp; gửi email" FontSize="12" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
